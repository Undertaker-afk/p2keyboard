<?xml version="1.0" encoding="utf-8"?>
<!-- Only used to switch the board's keyboard when a phone connects or leaves.
     No window content is read (canRetrieveWindowContent=false). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:notificationTimeout="1000"
    android:settingsActivity="app.p2keyboard.MainActivity" />
