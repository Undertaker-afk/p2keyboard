<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#5AA9FF</item>
        <item name="android:windowBackground">@color/ic_bg</item>
        <item name="android:statusBarColor">@color/ic_bg</item>
        <item name="android:navigationBarColor">@color/ic_bg</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textColor">#5AA9FF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#B7C1CB</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
