<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E8EDF2"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- This device: name (tap to rename) + ID -->
        <LinearLayout
            android:id="@+id/device_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/row_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/this_device"
                android:textColor="#8D99A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E8EDF2"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#5AA9FF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Phone build: pair and connect to boards -->
        <LinearLayout
            android:id="@+id/phone_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_pair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#5AA9FF"
                android:text="@string/pair_device"
                android:textAllCaps="false"
                android:textColor="#06223F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Devices this phone can type on -->
            <TextView
                style="@style/Section"
                android:text="@string/paired_devices" />

            <LinearLayout
                android:id="@+id/board_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Body"
                android:text="@string/paired_devices_hint"
                android:textColor="#8D99A6"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Board build: setup, on/off, pairing code, paired phones -->
        <LinearLayout
            android:id="@+id/board_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Smart board role -->
            <TextView
                style="@style/Section"
                android:layout_marginTop="24dp"
                android:text="@string/role_board" />

            <TextView
                style="@style/Body"
                android:text="@string/role_board_desc" />

            <Switch
                android:id="@+id/board_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/row_bg"
                android:padding="14dp"
                android:text="@string/board_on"
                android:textColor="#E8EDF2"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_enable"
                    style="@style/SetupButton"
                    android:text="@string/step_enable" />

                <Button
                    android:id="@+id/btn_background"
                    style="@style/SetupButton"
                    android:text="@string/step_background" />

                <Button
                    android:id="@+id/btn_autoswitch"
                    style="@style/SetupButton"
                    android:text="@string/step_autoswitch" />
            </LinearLayout>

            <TextView
                android:id="@+id/board_status"
                style="@style/Body"
                android:textColor="#E8EDF2" />

            <TextView
                android:id="@+id/bg_status"
                style="@style/Body"
                android:textColor="#E8EDF2" />

            <TextView
                android:id="@+id/switch_status"
                style="@style/Body"
                android:textColor="#E8EDF2" />

            <!-- Shown when this device is a board: pairing code + paired phones -->
            <LinearLayout
                android:id="@+id/board_qr_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/board_qr"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:contentDescription="@string/qr_desc"
                        android:padding="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/board_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B7C1CB"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btn_board_new_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/new_code" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Section"
                    android:layout_marginTop="18dp"
                    android:text="@string/paired_phones"
                    android:textSize="17sp" />

                <LinearLayout
                    android:id="@+id/phone_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#5AA9FF"
            android:hint="@string/test_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="#E8EDF2"
            android:textColorHint="#8D99A6" />
    </LinearLayout>
</ScrollView>
