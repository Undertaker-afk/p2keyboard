<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E8EDF2"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_intro"
            android:textColor="#B7C1CB"
            android:textSize="16sp" />

        <!-- Phone -->
        <TextView
            style="@style/Section"
            android:text="@string/role_phone" />

        <TextView
            style="@style/Body"
            android:text="@string/role_phone_desc" />

        <Button
            android:id="@+id/btn_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_phone" />

        <!-- Board -->
        <TextView
            style="@style/Section"
            android:text="@string/role_board" />

        <TextView
            style="@style/Body"
            android:text="@string/role_board_desc" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_enable" />

            <Button
                android:id="@+id/btn_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/step_select" />

            <Button
                android:id="@+id/btn_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/step_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/board_status"
            style="@style/Body"
            android:textColor="#E8EDF2" />

        <TextView
            android:id="@+id/bg_status"
            style="@style/Body"
            android:textColor="#E8EDF2" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#5AA9FF"
            android:hint="@string/test_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="#E8EDF2"
            android:textColorHint="#8D99A6" />
    </LinearLayout>
</ScrollView>
