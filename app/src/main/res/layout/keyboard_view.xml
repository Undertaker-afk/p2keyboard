<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Shown while waiting for a phone -->
    <LinearLayout
        android:id="@+id/pair_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:contentDescription="Pairing QR code"
            android:padding="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title"
                android:textColor="#E8EDF2"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pair_steps"
                android:textColor="#B7C1CB"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8D99A6"
                android:textIsSelectable="false"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shown once a phone is paired -->
    <TextView
        android:id="@+id/connected_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/connected"
        android:textColor="#35C46A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_new_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_code" />

        <Button
            android:id="@+id/btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/switch_kb" />
    </LinearLayout>
</LinearLayout>
